# Copy to .env.local and fill in. Every variable here is REQUIRED — there are no
# code-level defaults, so a missing value fails on boot rather than silently
# connecting to the wrong database or refusing every login.
#
# Scripts and tests read this the same way the app does, via lib/env.mjs.
# To point one at another database without editing the file, override inline:
#
#   MONGODB_URI='mongodb+srv://…' node scripts/regen-cards.mjs
#
# An inline value always wins over .env.local.

# MongoDB connection string.
#   local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=

# Database name. Held separately from the URI so the same cluster can host more
# than one environment.
MONGODB_DB=

# Signing key for the admin session cookie. Must be at least 32 characters —
# lib/admin/auth.ts rejects anything shorter.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
