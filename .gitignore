# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env holds real credentials and must never be committed.
# lib/env.mjs reads .env.local > .env.development > .env, same order as Next.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
